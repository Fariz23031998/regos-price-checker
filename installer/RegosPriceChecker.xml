<service>
  <!-- Local System is the default account when serviceaccount is omitted. -->
  <id>RegosPriceChecker</id>
  <name>REGOS Price Checker</name>
  <description>Serves the REGOS price checker and syncs the catalog from Firebird.</description>
  <executable>%BASE%\runtime\node.exe</executable>
  <arguments>"%BASE%\backend\dist\index.js"</arguments>
  <workingdirectory>%BASE%\backend</workingdirectory>
  <logpath>%BASE%\backend\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>
  <startmode>Automatic</startmode>
  <stoptimeout>15 sec</stoptimeout>
</service>
